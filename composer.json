{
    "name": "ryangjchandler/filament-navigation",
    "description": "Build structured navigation menus in Filament.",
    "keywords": [
        "ryangjchandler",
        "laravel",
        "filament-navigation"
    ],
    "homepage": "https://github.com/ryangjchandler/filament-navigation",
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Chandler",
            "email": "support@ryangjchandler.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.5.1",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.9.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "nunomaduro/collision": "^7.0|^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.5|^12.0",
        "spatie/laravel-ray": "^1.26",
        "larastan/larastan": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RyanChandler\\FilamentNavigation\\": "src",
            "RyanChandler\\FilamentNavigation\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RyanChandler\\FilamentNavigation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage",
        "format": "vendor/bin/php-cs-fixer fix --config=.php_cs.dist.php --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.33"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RyanChandler\\FilamentNavigation\\FilamentNavigationServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-codex/filament-4": "2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
